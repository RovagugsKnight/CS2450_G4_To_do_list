<InputFrame>:
    orientation: "vertical"
    spacing: "10dp"
    padding: "0dp"
    
    # --- WIDTH CONTROL ---
    size_hint_x: 1
    pos_hint: {"center_x": 0.5}
    
    # --- HEIGHT CONTROL ---
    size_hint_y: None
    height: self.minimum_height

    # --- HEADER ROW (Always Visible) ---
    MDBoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "50dp"
        spacing: "10dp"

        MDTextField:
            id: task_name
            mode: "fill"
            hint_text: "Task Name"
            multiline: False
            size_hint_y: 1  
            font_size: "18sp"
            on_focus: 
                if self.focus: root.expand_menu(self.focus)

        YellowButton:
            text: "+"
            color: 0, 0, 0, 1
            font_size: "30sp"
            size_hint: None, 1  
            width: "60dp"
            on_release: root.add_task()

    # --- HIDDEN MENU ROW (Expands Downward) ---
    MDBoxLayout:
        id: extra_fields
        orientation: "vertical"
        size_hint_y: None
        height: "0dp"
        opacity: 0
        disabled: True  
        spacing: "10dp"
        padding: "0dp"

        MDTextField:
            id: deadline
            mode: "fill"
            hint_text: "Deadline (mm/dd/yyyy)"
            multiline: False
            size_hint_y: None
            height: "50dp"

        MDTextField:
            id: description
            mode: "fill"
            hint_text: "Description"
            multiline: True
            size_hint_y: None
            height: "80dp"
        
        CategorySelector:
            id: cat_list