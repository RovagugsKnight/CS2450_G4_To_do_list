#:include task_manager_app/src/views/main_window.kv

MDBoxLayout:
    orientation: "vertical"
    md_bg_color: 0.90, 0.90, 0.90, 1

    # -------------------------
    # FLOATING HEADER (FIXED)
    # -------------------------
    MDBoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "96dp"
        padding: [16, 8, 24, 20]
        spacing: "12dp"

        canvas.before:
            Color:
                rgba: 0, 0, 0, 0
            Rectangle:
                pos: self.pos
                size: self.size

        # HAMBURGER → DROPDOWN MENU
        MDIconButton:
            id: nav_button
            icon: "menu"
            icon_size: "42dp"
            padding: "6dp"
            theme_text_color: "Custom"
            text_color: 0.20, 0.20, 0.20, 1
            on_release: main_window.open_nav_menu()

        MDCard:
            size_hint_y: None
            height: "64dp"
            radius: [12, 12, 12, 12]
            elevation: 2
            padding: "12dp"
            size_hint_x: 1
            md_bg_color: 0.94, 0.94, 0.94, 1

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"

                MDLabel:
                    text: "Task Manager"
                    font_style: "H5"
                    valign: "center"
                    size_hint_x: 1
                    theme_text_color: "Custom"
                    text_color: 0.20, 0.20, 0.20, 1

                MDRaisedButton:
                    text: "Create Task"
                    icon: "plus"
                    md_bg_color: 0.25, 0.45, 0.85, 1
                    on_release: main_window.open_add_dialog()

    # -------------------------
    # CONTENT ONLY (NO DRAWER)
    # -------------------------
    ScreenManager:
        MainWindow:
            id: main_window
            name: "main"
