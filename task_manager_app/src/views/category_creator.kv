<CategoryCreator>:
    orientation: "vertical"
    spacing: "12dp"
    padding: "12dp"

    MDTextField:
        id: cat_name
        hint_text: "Category Name"
        size_hint_y: None
        height: "48dp"

    BoxLayout:
        id: color_area
        size_hint_y: None
        height: "50dp"

    BoxLayout:
        id: submit_area
        size_hint_y: None
        height: "60dp"
