<AddTaskContent>:
    selected_category: "Todo"

    orientation: "vertical"
    spacing: "12dp"
    padding: "12dp"
    size_hint_y: None
    height: self.minimum_height

    MDTextField:
        id: task_name
        hint_text: "Task Name"
        size_hint_y: None
        height: "48dp"

    MDTextField:
        id: description
        hint_text: "Description (Optional)"
        size_hint_y: None
        height: "120dp"
        multiline: True

    MDTextField:
        id: deadline
        hint_text: "Deadline (optional)"
        readonly: True
        size_hint_y: None
        height: "48dp"
        on_focus:
            if self.focus: app.root.ids.main_window.open_deadline_for_field(self)

    MDBoxLayout:
        id: category
        orientation: "horizontal"
        spacing: "8dp"
        size_hint_y: None
        height: "48dp"

        MDLabel:
            id: category_label
            text: "Category: " + root.selected_category
            halign: "left"
            valign: "middle"
            text_size: self.size
            size_hint_x: 1
            theme_text_color: "Custom"
            text_color: 0.87, 0.87, 0.87, 1   # EXACT MDTextField dark-mode color

        MDIconButton:
            icon: "chevron-down"
            size_hint_x: None
            width: "48dp"
            on_release:
                app.root.ids.main_window.category_menu.caller = root
                app.root.ids.main_window.category_menu.open()

        MDIconButton:
            icon: "plus"
            size_hint_x: None
            width: "48dp"
            on_release:
                app.root.ids.main_window.open_category_creator(source="add_task")


<EditTaskContent>:
    selected_category: root.cat_name if hasattr(root, "cat_name") else "Todo"

    orientation: "vertical"
    spacing: "12dp"
    padding: "12dp"
    size_hint_y: None
    height: self.minimum_height

    MDTextField:
        id: task_name
        hint_text: "Task Name"
        size_hint_y: None
        height: "48dp"

    MDTextField:
        id: description
        hint_text: "Description (Optional)"
        size_hint_y: None
        height: "120dp"
        multiline: True

    MDTextField:
        id: deadline
        hint_text: "Deadline (optional)"
        readonly: True
        size_hint_y: None
        height: "48dp"
        on_focus:
            if self.focus: app.root.ids.main_window.open_deadline_for_field(self)

    MDBoxLayout:
        id: category
        orientation: "horizontal"
        spacing: "8dp"
        size_hint_y: None
        height: "48dp"

        MDLabel:
            id: category_label
            text: "Category: " + root.selected_category
            halign: "left"
            valign: "middle"
            text_size: self.size
            size_hint_x: 1
            theme_text_color: "Custom"
            text_color: 0.87, 0.87, 0.87, 1   # EXACT MDTextField dark-mode color

        MDIconButton:
            icon: "chevron-down"
            size_hint_x: None
            width: "48dp"
            on_release:
                app.root.ids.main_window.edit_category