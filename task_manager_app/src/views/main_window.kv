<MainWindow>:
    md_bg_color: 0.96, 0.96, 0.96, 1
    padding: [0, 24, 0, 0]

    MDScreenManager:
        id: screen_manager

        # ---------------------------------------------------
        # DASHBOARD SCREEN
        # ---------------------------------------------------
        MDScreen:
            name: "Dashboard"
            md_bg_color: 0.90, 0.90, 0.90, 1

            ScrollView:
                do_scroll_y: True
                do_scroll_x: False

                MDBoxLayout:
                    orientation: "vertical"
                    padding: "24dp"
                    spacing: "24dp"
                    size_hint_y: None
                    height: self.minimum_height

                    # Centered max-width container
                    MDBoxLayout:
                        id: dashboard_container
                        orientation: "vertical"
                        spacing: "24dp"
                        size_hint_x: None
                        width: min(self.parent.width if self.parent else dp(900), dp(900))
                        pos_hint: {"center_x": 0.5}
                        size_hint_y: None
                        height: self.minimum_height

                        # -------------------------
                        # DASHBOARD TITLE
                        # -------------------------
                        MDLabel:
                            text: "Dashboard"
                            font_style: "H5"
                            halign: "left"
                            theme_text_color: "Custom"
                            text_color: 0.20, 0.20, 0.20, 1
                            size_hint_y: None
                            height: self.texture_size[1]

                        # -------------------------
                        # PROGRESS OVERVIEW
                        # -------------------------
                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: "16dp"
                            size_hint_y: None
                            height: self.minimum_height

                            MDLabel:
                                text: "Progress Overview"
                                font_style: "Subtitle1"
                                theme_text_color: "Custom"
                                text_color: 0.25, 0.25, 0.25, 1
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDCard:
                                radius: 12
                                padding: "16dp"
                                md_bg_color: 0.94, 0.94, 0.94, 1
                                size_hint_y: None
                                height: self.minimum_height

                                MDBoxLayout:
                                    orientation: "vertical"
                                    spacing: "12dp"
                                    size_hint_y: None
                                    height: self.minimum_height

                                    MDLabel:
                                        text: "Tasks Completed Today"
                                        theme_text_color: "Custom"
                                        text_color: 0.25, 0.25, 0.25, 1
                                        size_hint_y: None
                                        height: self.texture_size[1]

                                    MDProgressBar:
                                        id: progress_today
                                        value: 40

                                    MDLabel:
                                        text: "Weekly Completion"
                                        theme_text_color: "Custom"
                                        text_color: 0.25, 0.25, 0.25, 1
                                        size_hint_y: None
                                        height: self.texture_size[1]

                                    MDProgressBar:
                                        id: progress_week
                                        value: 70

                        # -------------------------
                        # QUICK STATS ROW
                        # -------------------------
                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: "16dp"
                            size_hint_y: None
                            height: self.minimum_height

                            MDCard:
                                radius: 12
                                padding: "16dp"
                                size_hint: None, None
                                size: "200dp", "120dp"
                                md_bg_color: 0.94, 0.94, 0.94, 1

                                MDBoxLayout:
                                    orientation: "vertical"
                                    spacing: "8dp"

                                    MDLabel:
                                        text: "Total Tasks"
                                        theme_text_color: "Custom"
                                        text_color: 0.25, 0.25, 0.25, 1

                                    MDLabel:
                                        id: stat_total_tasks
                                        text: ""
                                        theme_text_color: "Custom"
                                        text_color: 0.25, 0.25, 0.25, 1
                                        font_style: "H6"
                                        halign: "left"

                            MDCard:
                                radius: 12
                                padding: "16dp"
                                size_hint: None, None
                                size: "200dp", "120dp"
                                md_bg_color: 0.94, 0.94, 0.94, 1

                                MDBoxLayout:
                                    orientation: "vertical"
                                    spacing: "8dp"

                                    MDLabel:
                                        text: "Due Today"
                                        theme_text_color: "Custom"
                                        text_color: 0.25, 0.25, 0.25, 1

                                    MDLabel:
                                        id: stat_due_today
                                        text: ""
                                        font_style: "H6"
                                        theme_text_color: "Custom"
                                        text_color: 0.25, 0.25, 0.25, 1
                                        halign: "left"

                        # -------------------------
                        # TODAY'S TASKS PREVIEW
                        # -------------------------
                        MDLabel:
                            text: "Today's Tasks"
                            font_style: "Subtitle1"
                            theme_text_color: "Custom"
                            text_color: 0.25, 0.25, 0.25, 1
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDCard:
                            radius: 12
                            padding: "16dp"
                            md_bg_color: 0.94, 0.94, 0.94, 1
                            size_hint_y: None
                            height: "200dp"

                            ScrollView:
                                do_scroll_y: True
                                do_scroll_x: False

                                MDList:
                                    id: dashboard_today_list
                                    size_hint_y: None
                                    height: self.minimum_height

        # ---------------------------------------------------
        # TASK BOARD SCREEN
        # ---------------------------------------------------
        MDScreen:
            name: "Task View"
            md_bg_color: 0.90, 0.90, 0.90, 1

            ScrollView:
                do_scroll_y: False
                do_scroll_x: True

                MDBoxLayout:
                    id: board_columns
                    orientation: "horizontal"
                    spacing: "24dp"
                    padding: "24dp"
                    size_hint_y: None
                    height: self.minimum_height
