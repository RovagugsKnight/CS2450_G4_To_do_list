<MainWindow>:
    md_bg_color: 0.96, 0.96, 0.96, 1
    padding: [0, 24, 0, 0]

    MDScreenManager:
        id: screen_manager

        # -------------------------
        # DASHBOARD SCREEN
        # -------------------------
        MDScreen:
            name: "Dashboard"
            md_bg_color: 0.90, 0.90, 0.90, 1

            MDBoxLayout:
                orientation: "vertical"
                padding: "24dp"
                spacing: "24dp"

                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_x: None
                    width: min(self.parent.width, dp(900))
                    pos_hint: {"center_x": 0.5}

                    # <-- Dashboard content goes here
                    # (progress bars, stats, etc.)

        # -------------------------
        # TASK BOARD SCREEN
        # -------------------------
        MDScreen:
            name: "Task View"
            md_bg_color: 0.90, 0.90, 0.90, 1

            ScrollView:
                do_scroll_y: False
                do_scroll_x: True

                MDBoxLayout:
                    id: board_columns
                    orientation: "horizontal"
                    spacing: "24dp"
                    padding: "24dp"
                    size_hint_y: None
                    height: self.minimum_height