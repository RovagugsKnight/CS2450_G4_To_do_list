<TaskItem>:
    size_hint_y: None
    height: "160dp"
    padding: "10dp"
    spacing: "10dp"

    # --- Main Card ---
    MDCard:
        radius: [20, 20, 20, 20]
        elevation: 6
        shadow_softness: 4
        shadow_offset: 0, -2
        md_bg_color: 1, 1, 1, 1
        padding: "14dp"
        size_hint_x: 1

        MDBoxLayout:
            orientation: "horizontal"
            spacing: "12dp"

            # --- Category Color Accent ---
            MDBoxLayout:
                size_hint_x: None
                width: "6dp"
                md_bg_color: root.color
                radius: [20, 0, 0, 20]

            # --- Text Content ---
            MDBoxLayout:
                orientation: "vertical"
                spacing: "6dp"

                MDLabel:
                    text: root.task_name
                    font_style: "H6"
                    theme_text_color: "Primary"
                    halign: "left"

                MDLabel:
                    text: root.description
                    font_style: "Body2"
                    theme_text_color: "Secondary"
                    halign: "left"
                    text_size: self.width, None

                MDLabel:
                    text: root.deadline
                    font_style: "Caption"
                    theme_text_color: "Hint"
                    halign: "right"
                    italic: True

    # --- Button Column ---
    MDBoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: "60dp"
        spacing: "4dp"
        padding: "4dp"

        MDIconButton:
            icon: "check"
            theme_text_color: "Custom"
            text_color: 0, 0.6, 0, 1
            disabled: root.done
            on_release: root.mark_done()

        MDIconButton:
            icon: "pencil"
            theme_text_color: "Custom"
            text_color: 0.2, 0.2, 0.2, 1
            on_release: root.edit_task()

        MDIconButton:
            icon: "trash-can"
            theme_text_color: "Custom"
            text_color: 0.7, 0, 0, 1
            on_release: root.remove()
