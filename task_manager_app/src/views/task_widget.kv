<TaskItem>:
    size_hint_y: None
    height: "90dp"
    md_bg_color: 0.92, 0.92, 0.92, 1   # light gray like the Dribbble example
    radius: [10, 10, 10, 10]
    elevation: 3
    padding: "12dp"
    spacing: "8dp"

    MDBoxLayout:
        orientation: "vertical"
        spacing: "6dp"

        MDLabel:
            text: root.task_name
            font_style: "H6"
            theme_text_color: "Custom"
            text_color: 0.1, 0.1, 0.1, 1
            size_hint_y: None
            height: self.texture_size[1]

        MDLabel:
            text: "Due: " + root.deadline if root.deadline else "No deadline"
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: 0.25, 0.25, 0.25, 1
            size_hint_y: None
            height: self.texture_size[1]

    MDBoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "32dp"
        spacing: "4dp"

        MDIconButton:
            icon: "check"
            theme_text_color: "Custom"
            text_color: 0, 0.6, 0, 1
            on_release: root.mark_done()

        MDIconButton:
            icon: "pencil"
            theme_text_color: "Custom"
            text_color: 0.2, 0.2, 0.2, 1
            on_release: root.edit_task()

        MDIconButton:
            icon: "trash-can"
            theme_text_color: "Custom"
            text_color: 0.8, 0, 0, 1
            on_release: root.delete_task()
