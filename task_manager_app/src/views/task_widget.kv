<TaskItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: self.minimum_height
    md_bg_color: 0.96, 0.96, 0.96, 1
    radius: [10, 10, 10, 10]
    elevation: 3
    padding: "10dp"
    spacing: "6dp"
    on_release: root.toggle_expand()

    # LEFT COLUMN (expands)
    MDBoxLayout:
        orientation: "vertical"
        spacing: "4dp"
        size_hint_x: 1
        size_hint_y: None
        height: self.minimum_height

        MDLabel:
            text: root.task_name
            font_style: "H6"
            theme_text_color: "Custom"
            text_color: 0.1, 0.1, 0.1, 1
            size_hint_y: None
            height: self.texture_size[1]

        MDLabel:
            text: "Due: " + root.deadline if root.deadline else "No deadline"
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: 0.25, 0.25, 0.25, 1
            size_hint_y: None
            height: self.texture_size[1]

        MDLabel:
            text: "Category: " + root.cat_name
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: 0.25, 0.25, 0.25, 1
            size_hint_y: None
            height: self.texture_size[1]

        # EXPANDABLE DESCRIPTION
        MDBoxLayout:
            id: desc_box
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height if root.is_expanded else 0
            opacity: 1 if root.is_expanded else 0

            MDLabel:
                text: root.description
                font_style: "Body2"
                theme_text_color: "Custom"
                text_color: 0.2, 0.2, 0.2, 1
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

    # RIGHT COLUMN (fixed height — buttons never move)
    MDBoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: "80dp"
        size_hint_y: None
        height: "90dp"   # ← FIXED HEIGHT = buttons stay put
        padding: 0
        spacing: 0

        # TOP ROW — checkbox + edit
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "40dp"
            spacing: "4dp"

            # CHECKBOX HITBOX
            MDBoxLayout:
                size_hint_x: None
                width: "36dp"
                padding: [6, 6, 0, 0]

                MDCheckbox:
                    size_hint: None, None
                    size: "22dp", "22dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    theme_text_color: "Custom"
                    color: 0.1, 0.1, 0.1, 1
                    active: root.done
                    on_release: root.toggle_done(self, self.active)

            # EDIT HITBOX
            MDBoxLayout:
                size_hint_x: None
                width: "36dp"

                MDIconButton:
                    icon: "pencil"
                    icon_size: "20dp"
                    padding: 0
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    theme_text_color: "Custom"
                    text_color: 0.2, 0.2, 0.2, 1
                    on_release: root.edit_task()

        # BOTTOM ROW — trashcan (triangle layout)
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "50dp"

            Widget:
                size_hint_x: None
                width: "20dp"

            MDBoxLayout:
                size_hint_x: None
                width: "36dp"

                MDIconButton:
                    icon: "trash-can"
                    icon_size: "20dp"
                    padding: 0
                    pos_hint: {"center_x": 0.5, "center_y": 0.3}  # lower position
                    theme_text_color: "Custom"
                    text_color: 0.8, 0, 0, 1
                    on_release: root.delete_task()
